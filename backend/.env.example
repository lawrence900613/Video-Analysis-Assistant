# ===== 大模型配置 (OpenAI 兼容协议) =====
# 支持 OpenAI / DeepSeek / Moonshot / 通义千问 等任意 OpenAI 兼容服务
# 填入你的 API Key
LLM_API_KEY=sk-your-api-key-here
# API 地址 (示例)
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Moonshot:  https://api.moonshot.cn/v1
#   通义:      https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名称 (示例: deepseek-chat / gpt-4o-mini / moonshot-v1-8k / qwen-plus)
LLM_MODEL=deepseek-chat

# ===== 下载配置 =====
# 临时下载目录 (相对 backend 目录)
DOWNLOAD_DIR=downloads
# 单个视频最大时长限制(秒), 0 表示不限制; 用于 AI 总结/翻译时控制字幕长度
MAX_SUBTITLE_CHARS=16000

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000
