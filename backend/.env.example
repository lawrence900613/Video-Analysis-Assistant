# ===== LLM configuration (OpenAI-compatible API) =====
# Supports OpenAI, DeepSeek, Moonshot, Qwen, and other OpenAI-compatible services
# Enter your API key
LLM_API_KEY=sk-your-api-key-here
# API base URL (examples)
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Moonshot:  https://api.moonshot.cn/v1
#   Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# Model name (examples: deepseek-chat / gpt-4o-mini / moonshot-v1-8k / qwen-plus)
LLM_MODEL=deepseek-chat

# ===== Download configuration =====
# Temporary download directory (relative to backend/)
DOWNLOAD_DIR=downloads
# Max subtitle characters for AI summary/translation; 0 means no limit
MAX_SUBTITLE_CHARS=16000
# Map-Reduce chunk size for long videos
CHUNK_MAX_CHARS=6000
# Hard limit for AI analysis duration (seconds); default 2 hours
MAX_ANALYSIS_DURATION_SEC=7200

# Optional: YouTube / Bilibili / site cookies.
# Use this when a platform only exposes subtitles or media after login.
# For Bilibili videos that show captions in your browser but return
# "login required" in the app, export Netscape-format cookies to a file:
#   YTDLP_COOKIES=C:/Users/you/Downloads/bilibili-cookies.txt
# Or let yt-dlp read an installed browser profile on the backend machine:
#   YTDLP_COOKIES_FROM_BROWSER=edge
#   YTDLP_COOKIES_FROM_BROWSER=chrome
# Restart the backend after changing either value.
# YTDLP_COOKIES=cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=edge

# ===== Server configuration =====
HOST=0.0.0.0
PORT=8000
